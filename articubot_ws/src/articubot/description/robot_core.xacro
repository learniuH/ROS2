<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="inertial_macros.xacro"/>

    <xacro:property name="chassis_length" value="0.3" />
    <xacro:property name="chassis_width" value="0.3" />
    <xacro:property name="chassis_height" value="0.15" />
    <xacro:property name="chassis_mass" value="0.5" />

    <xacro:property name="wheel_joint_y" value="0.175" />
    <xacro:property name="wheel_radius" value="0.05" />
    <xacro:property name="wheel_length" value="0.04" />
    <xacro:property name="wheel_mass" value="0.1" />

    <xacro:property name="caster_radius" value="0.05" />
    <xacro:property name="caster_joint_x" value="0.24" />
    <xacro:property name="caster_mass" value="0.1" />

    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>

    <material name="orange">
        <color rgba="1.0 0.3 0.1 1.0"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1.0 1.0"/>
    </material>

    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>

    <!-- BASE LINK -->

    <link name="base_link"></link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="-0.1 0.0 0.0"/>
    </joint>

    <!-- CHASSIS LINK -->

    <link name="chassis">
        <visual>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <origin xyz="${chassis_length/2} 0.0 ${chassis_height/2}"/>
            <material name="white" />
        </visual>

        <collision>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <origin xyz="${chassis_length/2} 0.0 ${chassis_height/2}"/>
        </collision>

        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="${chassis_length/2} 0.0 ${chassis_height/2}" rpy="0.0 0.0 0.0"/>
        </xacro:inertial_box>
    </link>

    <!-- WHEEL FUNC -->
    
    <xacro:macro name="wheel_func" params="link_name left_flag">
        <joint name="${link_name}_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${link_name}"/>
            <origin xyz="0.0 ${wheel_joint_y * left_flag} 0.0" rpy="${-pi/2 * left_flag} 0.0 0.0"/>
            <!-- axis 轴为负时为左手定则 -->
            <axis xyz="0.0 0.0 ${1.0 * left_flag}"/>
        </joint>

        <link name="${link_name}">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <material name="blue" />
            </visual>

            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
            </collision>
        </link>

        <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_length}">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </xacro:inertial_cylinder>
    </xacro:macro>

    <!-- WHEEL LINK -->

    <xacro:wheel_func link_name="left_wheel" left_flag="1" />
    <xacro:wheel_func link_name="right_wheel" left_flag="-1" />

    <!-- CASTER LINK -->

    <joint name="caster_wheel_joint" type="fixed">
        <parent link="chassis"/>
        <child link="caster_wheel"/>
        <origin xyz="${caster_joint_x} 0.0 0.0"/>
    </joint>

    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <material name="black" />
        </visual>
        
        <collision>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
        </collision>

        <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </xacro:inertial_sphere>
    </link>
    
</robot>