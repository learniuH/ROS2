<launch>
    <!-- 演示node使用 -->
    <node 
        pkg="turtlesim"
        exec="turtlesim_node"
        name="turtle_xml"
        namespace="ns_xml"
        exec_name="custom_turtle"
        ros_args="--remap /ns_xml/turtle1/cmd_vel:=/cmd_vel"
        args="--ros-args --remap /ns_xml/turtle1/pose:=/pose"
        respawn="True"
    >
        <!-- 设置单个参数 -->
        <!-- <param name="background_r" value="255" /> -->
        <!-- 从yaml文件中读取参数 -->
        <param from="$(find-pkg-share cpp01_launch)/config/ns_xml__turtle_xml.yaml" />
    </node>
</launch>