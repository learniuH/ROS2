<!-- 
    演示宏的定义与调用 
    测试：xacro demo02_func.urdf.xacro
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Lbot">
    <!-- 宏的定义 -->
    <xacro:macro name="wheel_func" params="wheel_name">
        <link name="${wheel_name}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="0.0" length="0.0"/>
                </geometry>
            </visual>
        </link>
    </xacro:macro>
    <!-- 宏的调用 -->
    <xacro:wheel_func wheel_name="left" />
    <xacro:wheel_func wheel_name="right" />
</robot>