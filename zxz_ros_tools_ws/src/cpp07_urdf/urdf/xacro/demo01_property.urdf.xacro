<!-- 演示变量使用
     1.变量声明；
     2.变量调用；
     3.变量运算；    
     测试：
        xacro demo01_property.urdf.xacro
 -->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Lbot">
    <!-- 变量声明 -->
    <xacro:property name="PI" value="3.1416" />
    <xacro:property name="wheel_radius" value="0.025" />
    <xacro:property name="wheel_length" value="0.02"/>

    <link name="wheel">
        <visual>
            <!-- 变量调用 -->
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <!-- 变量运算 -->
            <origin rpy="${PI / 2} 0.0 0.0"/>
        </visual>
    </link>
</robot>