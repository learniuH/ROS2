<!-- 底盘实现 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 变量声明 -->
    <xacro:property name="PI" value="3.1415927"/>
    <xacro:property name="car_length" value="0.2"/>
    <xacro:property name="car_width" value="0.12"/>
    <xacro:property name="car_height" value="0.07"/>
    <!-- 离地间距 -->
    <xacro:property name="destination" value="0.015"/>

    <xacro:property name="wheel_radius" value="0.025"/>
    <xacro:property name="wheel_width" value="0.02"/>
    <xacro:property name="wheel_joint_x" value="0.08"/>
    <xacro:property name="wheel_joint_y" value="${car_width/2}"/>
    <xacro:property name="wheel_joint_z" value="${-(car_height/2 + destination - wheel_radius)}"/>

    <!-- 颜色提取 -->
    <material name="yellow">
        <color rgba="0.9 0.6 0.0 0.8"/>
    </material>

    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>

    <link name="base_footprint">
        <visual>
            <geometry>
                <sphere radius="0.0001"/>
            </geometry>
        </visual>
    </link>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${car_length} ${car_width} ${car_height}"/>
            </geometry>
            <material name="yellow" />
        </visual>
    </link>

    <!-- 设置离地间距 -->
    <joint name="basefoot2baselink" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 ${car_height/2 + destination}"/>
    </joint>

    <!-- 定义车轮宏 -->
    <xacro:macro name="wheel_func" params="link_name front_flag left_flag">
        <link name="${link_name}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <origin rpy="${PI/2} 0.0 0.0"/>
                <material name="black" />
            </visual>
        </link>
        
        <joint name="${link_name}2baselink" type="continuous">
            <parent link="base_link"/>
            <child link="${link_name}_wheel"/>
            <origin xyz="${wheel_joint_x * front_flag} ${wheel_joint_y * left_flag} ${wheel_joint_z}"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
    </xacro:macro>

    <!-- 车轮宏调用 -->
    <xacro:wheel_func link_name="left_front" front_flag="1" left_flag="1"/>
    <xacro:wheel_func link_name="right_front" front_flag="1" left_flag="-1"/>
    <xacro:wheel_func link_name="left_back" front_flag="-1" left_flag="1"/>
    <xacro:wheel_func link_name="right_back" front_flag="-1" left_flag="-1"/>

</robot>